    {
      "about": "a name no case of an enumeration has",
      "type": "forms.Colour",
      "input": "Blue",
      "expect": [
        {
          "path": "",
          "code": "not_allowed",
          "messageKey": "not_allowed",
          "meta": {
            "allowed": [
              "Green",
              "Red"
            ],
            "actual": "Blue"
          }
        }
      ],
      "note": "Raoh's oneOf over strings, which states the rule an enumeration's name is held to: compared exactly, case and all. The names are in code point order, not the order the cases are declared in.",
      "messages": {
        "en": [
          "must be one of [Green, Red]"
        ],
        "ja": [
          "[Green, Red]のいずれかで入力してください"
        ]
      }
    },
    {
      "about": "a name of a case written in another case",
      "type": "forms.Colour",
      "input": "red",
      "expect": [
        {
          "path": "",
          "code": "not_allowed",
          "messageKey": "not_allowed",
          "meta": {
            "allowed": [
              "Green",
              "Red"
            ],
            "actual": "red"
          }
        }
      ],
      "note": "Raoh's enum would fold ASCII case and read it as Red; an enumeration's name is compared exactly.",
      "messages": {
        "en": [
          "must be one of [Green, Red]"
