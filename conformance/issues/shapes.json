{
  "model": "module forms\n\ndata Point = { x: Int, label: String, note: String? }\n\ndata Red\ndata Green\ndata Colour = Red | Green\n\ndata Circle = { radius: Int }\ndata Square = { side: Int }\ndata Shape = Circle | Square\n\ndata Day = Date\n\ndata At = Time\n\ndata Stamp = DateTime\n\ndata Moment = Instant\n\ndata Amount = Decimal\n\ndata Flag = Bool\n\ndata Points = List<Point>\n\ndata Counts = Map<String, Int>\n\ndata Unique = Set<Int>\n\ndata ByDay = Map<Date, Int>\n\ndata ByColour = Map<Colour, Int>\n\ndata Tracking = Int\ndata Untracked\ndata Shipment = Tracking | Untracked\n\ndata Wire = { iban: String }\ndata Card = { last4: String }\ndata Payment = Wire | Card\n",
  "cases": [
    {
      "about": "a field of the wrong kind",
      "type": "forms.Point",
      "input": {
        "x": "one",
        "label": "a"
      },
      "expect": [
        {
          "path": "/x",
          "code": "type_mismatch",
          "messageKey": "type_mismatch",
          "meta": {
            "actual": "string",
            "expected": "long"
          }
        }
      ],
      "messages": {
        "en": [
          "expected long"
        ],
        "ja": [
          "long型が必要です"
        ]
      }
    },
