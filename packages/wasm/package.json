{
  "name": "@souther/wasm",
  "version": "0.1.0",
  "description": "Load and call a Souther program compiled to WebAssembly, and generate its TypeScript binding",
  "license": "EPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/souther-lang/souther-wasm-compiler.git",
    "directory": "packages/wasm"
  },
  "homepage": "https://github.com/souther-lang/souther-wasm-compiler/tree/develop/packages/wasm#readme",
  "bugs": "https://github.com/souther-lang/souther-wasm-compiler/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    }
  },
  "bin": {
    "souther-wasm-bindings": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "compile-tests": "tsc -p tsconfig.runtime.json"
  },
  "devDependencies": {
    "@raoh/core": "0.9.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@raoh/core": "^0.9.0"
  }
}
