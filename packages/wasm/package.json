{
  "name": "@souther/wasm",
  "version": "0.1.0",
  "description": "Load and call a Souther program compiled to WebAssembly, and generate its TypeScript binding",
  "license": "EPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "default": "./dist/generate.js"
    }
  },
  "bin": {
    "souther-wasm-bindings": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@raoh/core": "github:raoh-project/raoh-ts#1397d5c93a8d9d79b5ec7b67c6266032831d9b71",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@raoh/core": "github:raoh-project/raoh-ts#1397d5c93a8d9d79b5ec7b67c6266032831d9b71"
  }
}
